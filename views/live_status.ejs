<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | VoltSense AI</title>
    <!-- Google Fonts: Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <style>
        .dynamic-badge {
            font-size: 0.85rem;
            padding: 5px 12px;
            border-radius: 20px;
        }
        .cell-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
            gap: 12px;
            margin-top: 15px;
        }
        .cell-card {
            background: #1e293b;
            border: 1px solid #334155;
            padding: 12px;
            border-radius: 8px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="page-wrapper">
        <!-- Header -->
        <header>
            <div class="container">
                <div class="header-brand">
                    <div class="brand-icon">⚡</div>
                    <h1 class="header-title">VoltSense AI</h1>
                </div>
                <p class="header-tagline">Dynamic EJS Template Engine Page (Task II.3)</p>
            </div>
        </header>

        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
            <div class="container">
                <a class="navbar-brand text-cyan font-weight-bold" href="/">VOLTSENSE AI</a>
                <div class="collapse navbar-collapse justify-content-center">
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" href="/">Home (Static)</a></li>
                        <li class="nav-item"><a class="nav-link" href="/dashboard.html">Dashboard (Static)</a></li>
                        <li class="nav-item"><a class="nav-link active" href="/live-status">Dynamic EJS Page</a></li>
                        <li class="nav-item"><a class="nav-link" href="/api/telemetry">API Telemetry</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Dynamic Content -->
        <main class="container my-5">
            <!-- Notice Banner -->
            <div class="alert alert-info border-0 shadow-sm mb-4">
                <strong><i class="bi bi-info-circle"></i> Task II.3 Demonstration:</strong> 
                This page is dynamically rendered on the server using the <strong>EJS Template Engine</strong>.
                Server Timestamp: <code><%= serverTime %></code>
            </div>

            <div class="row g-4">
                <!-- Vehicle & Battery Pack Overview -->
                <div class="col-lg-5">
                    <div class="card bg-dark text-light border-secondary p-4 shadow-sm h-100">
                        <h4 class="text-cyan mb-3">Vehicle Telemetry Summary</h4>
                        <table class="table table-dark table-borderless">
                            <tbody>
                                <tr>
                                    <th class="text-muted">Vehicle Model:</th>
                                    <td><strong><%= vehicle.model %></strong> (<%= vehicle.regNo %>)</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">Pack Voltage:</th>
                                    <td class="text-warning"><%= battery.voltage %> V</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">Current Draw:</th>
                                    <td><%= battery.current %> A</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">Power Output:</th>
                                    <td class="text-info"><%= battery.powerKW %> kW</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">State of Charge (SoC):</th>
                                    <td>
                                        <div class="progress" style="height: 18px;">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: <%= battery.soc %>%;" aria-valuenow="<%= battery.soc %>" aria-valuemin="0" aria-valuemax="100">
                                                <%= battery.soc %>%
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="text-muted">State of Health (SoH):</th>
                                    <td><span class="badge bg-primary"><%= battery.soh %>% (Good)</span></td>
                                </tr>
                                <tr>
                                    <th class="text-muted">Estimated Range:</th>
                                    <td class="text-success fw-bold"><%= battery.rangeKm %> km</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Cell Level Thermal Analytics (Dynamic Loop in EJS) -->
                <div class="col-lg-7">
                    <div class="card bg-dark text-light border-secondary p-4 shadow-sm h-100">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="text-cyan mb-0">Module Cell Temperatures</h4>
                            <span class="badge bg-secondary">Dynamic Array Loop</span>
                        </div>
                        <p class="text-muted small">Server rendered using EJS <code>&lt;% cells.forEach() %&gt;</code> loop:</p>

                        <div class="cell-grid">
                            <% cells.forEach(function(cell) { %>
                                <div class="cell-card">
                                    <div class="text-muted small">Cell #<%= cell.id %></div>
                                    <div class="fw-bold fs-5 <%= cell.temp > 35 ? 'text-danger' : 'text-success' %>">
                                        <%= cell.temp %> °C
                                    </div>
                                    <small class="text-muted"><%= cell.voltage %>V</small>
                                </div>
                            <% }); %>
                        </div>

                        <!-- Active Alerts (Conditional rendering in EJS) -->
                        <h5 class="text-cyan mt-4 mb-2">Diagnostic Alerts</h5>
                        <% if (alerts && alerts.length > 0) { %>
                            <ul class="list-group list-group-flush">
                                <% alerts.forEach(function(alert) { %>
                                    <li class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between align-items-center px-0">
                                        <span>
                                            <span class="badge bg-<%= alert.severity === 'WARNING' ? 'warning text-dark' : 'info' %> me-2">
                                                <%= alert.severity %>
                                            </span>
                                            <%= alert.message %>
                                        </span>
                                        <small class="text-muted"><%= alert.time %></small>
                                    </li>
                                <% }); %>
                            </ul>
                        <% } else { %>
                            <p class="text-success small mb-0">All thermal and electrical subsystems are operating normally.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
